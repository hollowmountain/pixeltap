# Ключи и доступы — в репозиторий не попадают ни при каких условиях.
env.txt
env*.txt
.env
.env.*
*.key
*.pem

# Полный каталог: продажи, остатки, скрытые позиции, заметки для кабинетов.
# Публичная часть для сборки — data/catalog.json.
data/private/

# Сборка — результат, а не исходник.
dist/
dist-pages/
node_modules/
.playwright-mcp/
.claude/
__pycache__/
*.pyc
.DS_Store

# Исходники сцен (5–8 МБ каждый). Сайту нужны только готовые варианты
# в site/img/, их и храним. Исходники — в архиве вне репозитория.
art/**/*.png
art/**/*.jpg
art/**/*.json
